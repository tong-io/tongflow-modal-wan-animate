{
    "plugin": {
        "name": "Wan-Animate-2",
        "description": "End-to-end character animation with Wan2.2-Animate-2-14B: character image + driving video, no pose extraction stage.",
        "icon": "/plugins/tongflow-modal-wan-animate.svg"
    },
    "env": [
        {
            "key": "MODAL_TOKEN_ID",
            "required": true,
            "description": "Modal token id",
            "url": "https://modal.com/settings/tokens"
        },
        {
            "key": "MODAL_TOKEN_SECRET",
            "required": true,
            "description": "Modal token secret (paired with MODAL_TOKEN_ID)"
        },
        {
            "key": "HF_TOKEN",
            "description": "Optional — Wan2.2-Animate-2-14B is public; a token only helps with Hugging Face rate limits",
            "url": "https://huggingface.co/settings/tokens",
            "required": false
        },
        {
            "key": "TONGFLOW_MODAL_CALL_TIMEOUT_S",
            "default": "3600",
            "description": "Max seconds to wait for a Modal call"
        }
    ]
}
